# =============================================
# NACOM Backend 환경 변수 (예시)
# =============================================
# .env 파일을 이 파일을 참고하여 작성하세요.

# MySQL 데이터베이스 연결
# 형식: mysql://username:password@host:port/database
# 로컬 개발: mysql://root:password@localhost:3306/nacom_db
# 프로덕션: mysql://user:pass@your-server.com:3306/nacom_db
DATABASE_URL="mysql://root:password@localhost:3306/nacom_db"

# JWT 서명에 사용할 비밀 키 (최소 32자 이상의 랜덤 문자열)
JWT_SECRET="your_super_secret_jwt_key_min_32_chars_here_1234567890"

# 서버 포트
PORT=3001

# 프론트엔드 주소 (CORS 허용 목록)
FRONTEND_URL="http://localhost:8081"

# 환경 설정 (development, production)
NODE_ENV="development"
