// This is your Prisma schema file.
// Learn more about it: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String   @unique
  password              String   // bcrypt hashed
  school                String
  grade                 Int
  role                  Role     @default(STUDENT)

  phone           String?  @unique
  phoneVerified   Boolean  @default(false)
  
  // 포인트 및 티켓 시스템
  points                Int      @default(0)         // 내공
  questionTickets       Int      @default(5)         // 질문 티켓 (최대 10)
  lastTicketRefillAt    DateTime?                    // 마지막 티켓 충전 시간
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  posts                 Post[]
  answers               Answer[]
  ticketRefillHistory   TicketRefillHistory[]

  @@index([email])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  icon  String?

  posts Post[]
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  imageUrl   String?  @db.MediumText  // Base64 이미지 저장
  views      Int      @default(0)
  isResolved Boolean  @default(false)
  tags       String?  // JSON 배열 문자열로 저장
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author     User     @relation(fields: [authorId], references: [id])
  authorId   Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  answers Answer[]

  @@index([authorId])
  @@index([categoryId])
}

model Answer {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  isAccepted Boolean  @default(false)
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User @relation(fields: [authorId], references: [id])
  authorId Int

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  @@index([postId])
  @@index([authorId])
}

enum Role {
  STUDENT
  ADMIN
}

// 티켓 재충전 기록 모델
model TicketRefillHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Int      // 추가 티켓 수
  reason      String   // "AUTO" (자동), "AD" (광고 시청)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// 게시글 조회 기록 (중복 방지)
model PostView {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  viewedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

// 답변 추천 기록 (중복 방지)
model AnswerUpvote {
  id        Int      @id @default(autoincrement())
  userId    Int
  answerId  Int
  createdAt DateTime @default(now())

  @@unique([userId, answerId])
  @@index([userId])
  @@index([answerId])
}

// 광고 시청 세션 (heartbeat 검증)
model AdSession {
  id            String    @id @default(uuid())
  userId        Int
  status        String    @default("STARTED") // "STARTED", "COMPLETED", "CLAIMED"
  heartbeats    Int       @default(0)
  startedAt     DateTime  @default(now())
  lastHeartbeat DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
}

